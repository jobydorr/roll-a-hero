rules_version = '2';

// Roll a Hero — Firestore security rules for character sharing.
//
// Model: campaigns/{campaignId}/characters/{docId}, where docId is
// "<ownerUid>__<charId>" and each doc carries an `ownerUid` field.
//
// Intent (kid-safe family app, anonymous sign-in):
//  - Anyone signed in (everyone is, anonymously) can READ a campaign's characters
//    — that's how the DM sees the whole party. Knowing the campaign code is the
//    practical gate.
//  - You can only CREATE/UPDATE/DELETE a character that belongs to YOU
//    (ownerUid must equal your own uid), so players can't tamper with each
//    other's heroes.
//
// This replaces the temporary "test mode" rules. Paste into
// Firebase console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    match /campaigns/{campaignId}/characters/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // The DM's notebook — a MIRROR of what lives in the DM's browser, so that a
    // Claude Code session can read the notes and help build the session log.
    // localStorage stays authoritative; nothing here is the only copy of anything.
    //
    // The gate is the notebook id, which is long and random and known only to the
    // DM. That is a curtain, not a vault — the same stance dm.html's passcode
    // takes — and it is deliberate: anonymous auth cannot tell one person from
    // another, so there is no stronger rule available without real accounts.
    // Nothing secret goes in here. Campaign spoilers do, which is why the id must
    // NOT be the party's campaign code: the players know that one.
    match /dmnotes/{notebookId}/docs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
